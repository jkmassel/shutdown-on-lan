[Unit]
Description=Shutdown on LAN – shuts this machine down when it receives a secret over the network
Documentation=https://github.com/jkmassel/shutdown-on-lan
After=network.target

[Service]
# The configuration is only read at startup – restart the service after changing it
ExecStart=/usr/bin/shutdown-on-lan
Restart=on-failure
RestartSec=5

# Runs as root, because shutting the machine down requires it. Everything else is locked down.
# The configuration is only read by the service, so /etc stays read-only – if it's missing, create it
# with `sudo shutdown-on-lan init` before starting the service.
# CAP_SYS_BOOT is only used if systemd can't be reached, and CAP_NET_BIND_SERVICE only if the port is
# below 1024.
CapabilityBoundingSet=CAP_SYS_BOOT CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
