[Unit]
Description=Shutdown on LAN – shuts this machine down when it receives a secret over the network
Documentation=https://github.com/jkmassel/shutdown-on-lan
After=network.target

[Service]
# Creates /etc/shutdown-on-lan.toml with a random secret, unless it already exists. It's created here, on the
# service's first start, rather than when the package is installed, so that every machine cloned from an image
# the package was installed in gets its own secret. `+` runs it outside the sandbox below, so it can write to
# /etc.
ExecStartPre=+/usr/bin/shutdown-on-lan init
# The configuration is only read at startup – restart the service after changing it
ExecStart=/usr/bin/shutdown-on-lan
Restart=on-failure
RestartSec=5

# Runs as root, because shutting the machine down requires it. Everything else is locked down.
# The service only reads the configuration, so /etc stays read-only.
# CAP_SYS_BOOT is only used if systemd can't be reached, and CAP_NET_BIND_SERVICE only if the port is
# below 1024.
CapabilityBoundingSet=CAP_SYS_BOOT CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
