<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jkmassel.shutdownonlan</string>
	<key>Program</key>
	<string>/Library/Services/shutdownonlan</string>
	<key>RunAtLoad</key>
	<true/>
	<!-- Restart the service if it exits with an error or crashes – launchd waits 10 seconds between attempts -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
</dict>
</plist>
