#!/bin/bash
set -e

## Stop the process (if needed) – this fails on first install, when it isn't loaded yet
launchctl unload -w /Library/LaunchDaemons/com.jkmassel.shutdownonlan.plist || true

## Create the configuration with a random secret, unless it already exists. This also imports the
## configuration file written by older versions.
/Library/Services/shutdownonlan init

## Put the tool on the PATH, with the same name as on the other platforms
mkdir -p /usr/local/bin
ln -sf /Library/Services/shutdownonlan /usr/local/bin/shutdown-on-lan

## Start the process
launchctl load -w /Library/LaunchDaemons/com.jkmassel.shutdownonlan.plist

exit 0
