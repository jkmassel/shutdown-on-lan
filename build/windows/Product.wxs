<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:fire="http://schemas.microsoft.com/wix/FirewallExtension" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
	<!-- `ProductVersion` is passed in by `.github/commands/build-for-windows.ps1`, from Cargo.toml -->
	<Product Id="*" Name="ShutdownOnLan" Language="1033" Version="$(var.ProductVersion)" Manufacturer="Jeremy Massel" UpgradeCode="755fa776-c302-4110-9be4-93578a393f09">
		<!-- Windows Installer 5.0 is needed for `ServiceConfig` -->
		<Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />

		<!-- Earlier installers were all versioned 1.0.0, regardless of the release, so allow "downgrading" to
		     replace them. This also lets a rebuild of the same version replace an existing installation. -->
		<MajorUpgrade AllowDowngrades="yes" />
		<MediaTemplate EmbedCab="yes" />

		<Feature Id="ProductFeature" Title="ShutdownOnLanInstaller" Level="1">
			<ComponentGroupRef Id="ProductComponents" />
		</Feature>
	
		<Property Id="ARPNOMODIFY" Value="yes" Secure="yes" />
		<Property Id="ARPNOREPAIR" Value="yes" Secure="yes" />
	</Product>

	<Fragment>
		<Directory Id="TARGETDIR" Name="SourceDir">
			<Directory Id="ProgramFiles64Folder">
				<Directory Id="INSTALLFOLDER" Name="ShutdownOnLan" />
			</Directory>
		</Directory>
	</Fragment>

	<Fragment>
		<ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
			<Component Id="ProductComponent">
				<File Id="ShutdownOnLanExe" Name="shutdown-on-lan.exe" Source="shutdown-on-lan.exe" Vital="yes" KeyPath="yes">
					<fire:FirewallException Id="Allow" Name="ShutdownOnLan" Scope="localSubnet"/>
				</File>
				<!-- The name must match `SERVICE_NAME` in src/windows_listener_service.rs -->
				<ServiceInstall Type="ownProcess" Vital="yes" Name="ShutdownOnLan" DisplayName="ShutdownOnLan" Description="Shuts down the computer in response to an external signal." Start="auto" Account="LocalSystem" ErrorControl="normal" Interactive="no">
					<!-- Restart the service if it fails. The service stops itself with an error code when it can't
					     listen, rather than crashing, so the restart has to apply to that too. -->
					<util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart" RestartServiceDelayInSeconds="5" ResetPeriodInDays="1" />
					<ServiceConfig FailureActionsWhen="failedToStopOrReturnedError" OnInstall="yes" OnReinstall="yes" />
				</ServiceInstall>
				<!-- The service logs to the Application event log. The executable contains the message resources. The
				     name must match the event source in src/logging.rs -->
				<util:EventSource Name="ShutdownOnLan" Log="Application" EventMessageFile="[#ShutdownOnLanExe]" SupportsErrors="yes" SupportsWarnings="yes" SupportsInformationals="yes" />
				<ServiceControl Id="StartService" Stop="both" Start="install" Remove="uninstall" Name="ShutdownOnLan" Wait="yes" />
			</Component>
		</ComponentGroup>
	</Fragment>
</Wix>
